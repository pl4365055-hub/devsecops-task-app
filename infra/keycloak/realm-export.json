{
  "realm": "taskapp",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "管理員角色"
      },
      {
        "name": "USER",
        "description": "一般使用者角色"
      }
    ]
  },
  "clients": [
    {
      "clientId": "task-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:80/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [
        "http://localhost",
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@taskapp.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "USER"],
      "requiredActions": []
    },
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Normal",
      "lastName": "User",
      "email": "user@taskapp.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"],
      "requiredActions": []
    }
  ]
}